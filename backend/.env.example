# docker-compose'daki MySQL servisine baglanti (kok .env dosyasindaki degerlerle eslesmeli)
DATABASE_URL="mysql://congress_beacon:changeme@localhost:3306/congress_beacon"

# Backend HTTP portu (web/ paneli 3000'i kullandigi icin varsayilan 3001'dir)
PORT=3001

# Mobil JWT (pilot-login) imzalama anahtari - gercek/gizli bir deger ile degistirin
JWT_SECRET=changeme-generate-a-random-secret

# Yetkili panelinin (web/) calistigi origin - CORS icin gerekli, aksi halde
# tarayicidan yapilan istekler (canli yenileme, ham gozlem akisi vb.) sessizce basarisiz olur
CORS_ORIGIN=http://localhost:3000

# docker-compose'daki Redis servisine baglanti - BullMQ (bayat ziyaret temizligi,
# oturum-oncesi bildirim zamanlamasi) bunu kullanir
REDIS_URL=redis://localhost:6379

# SMTP (Faz 1 - /auth/register-request ve /auth/forgot-password dogrulama
# kodu e-postasi). Tumu bos birakilirsa gonderim yapilmaz, kod yalnizca
# sunucu loguna yazilir (bkz. LoggingMailSender) - yerel gelistirmede bu
# yeterlidir.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@congress-beacon.local

# Faz 4b - PDF/Excel'den bilimsel program cikarimi (Claude API). Bos
# birakilirsa /admin/program-imports uc noktalari 503 doner, uygulama
# COKMEZ (bkz. ProgramExtractionService, MailSender'daki zarif dusme
# deseniyle ayni). Gercek anahtar olmadan yerel gelistirmede bu boyle
# birakilabilir.
ANTHROPIC_API_KEY=
# Varsayilan model bilincli sekilde daha ucuz Opus 4.8 - kullanicinin API
# kredisi sinirli (bkz. docs/decisions.md, Faz 4b). Model karsilastirmasi
# sonucuna gore degistirilebilir; asla koda gomulmez.
ANTHROPIC_MODEL=claude-opus-4-8
# 128000 (model destegi ust siniri) - Faz 4b canli testinde 100-150 sayfalik
# gercek belgelerde cikti token sayisi 64000'i asip cikarimin kesilmis/
# gecersiz JSON ile basarisiz olmasina yol acabilecegi gozlemlendi.
ANTHROPIC_MAX_OUTPUT_TOKENS=128000

# Faz 5 - mobil okuma API'leri. Yuklenen gorseller (Faz 3) goreli yol olarak
# saklanir (/uploads/...); mobil FARKLI bir origin'den calisacagi icin
# yanitlardaki gorsel URL'leri bu deger ile MUTLAK hale getirilir (bkz.
# common/absolute-url.ts). Bos birakilirsa yerel gelistirmede PORT'a gore
# (http://localhost:3001 gibi) otomatik bir varsayilan uretilir - bu yuzden
# yerelde genelde bos birakilabilir, yalnizca production'da zorunludur.
APP_PUBLIC_URL=

# Faz 9 - push bildirimleri (FCM). Firebase Console > Proje Ayarlari >
# Servis Hesaplari'ndan indirilen JSON dosyasinin TAM ICERIGI (tek satirda,
# dosya yolu DEGIL). Bos birakilirsa LoggingNotificationSender kullanilir -
# gonderim yapilmaz, yalnizca sunucu loguna yazilir, uygulama COKMEZ (bkz.
# NotificationsModule, MailSender'daki zarif dusme deseniyle ayni). Gercek
# anahtar olmadan yerel gelistirmede bu boyle birakilabilir. Gercek anahtari
# ASLA .env.example'a veya git'e YAZMA.
FIREBASE_SERVICE_ACCOUNT_JSON=
