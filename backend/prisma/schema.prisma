// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model Congress {
  id                         String    @id @default(uuid())
  name                       String
  code                       String    @unique
  accessCode                 String
  beaconUuid                 String
  startDate                  DateTime?
  endDate                    DateTime?
  // Mobil ana sayfa kongre karti icin Faz 3 alanlari - hepsi nullable,
  // mevcut kongreler (bu alanlar hic doldurulmadan) bozulmasin diye.
  // `name` kisa/etiket adi olarak KALIYOR (kod/URL/panel listelerinde
  // kullanilir); `fullName` resmi tam addir (mobil kartta gosterilir).
  fullName                   String?
  description                String?   @db.Text
  coverImageUrl              String?
  websiteUrl                 String?
  contactEmail               String?
  contactPhone               String?
  // Mobil cihazlarin observation batch'lerini kac saniyede bir gonderecegini
  // belirler. Panelden degistirilebilir; mobil uygulama bunu koda gomulu
  // sabit yerine her batch gonderiminde backend'den ogrenir (bkz.
  // POST /observations/batch response'u).
  observationIntervalSeconds Int       @default(10)

  // Salon tespit algoritmasi v3 ayarlari. Ayri bir AlgorithmConfig tablosu
  // KURULMUYOR - proje zaten kongre-bazli ayar desenini (yukaridaki
  // observationIntervalSeconds) kullaniyor; bu olcekte ayri bir tablo erken
  // karmasiklik olurdu. Saha kalibrasyonunda panelden ince ayar yapilir.
  emaAlpha                  Float @default(0.35)
  hampelK                   Float @default(3)
  hampelWindowSize          Int   @default(5)
  confidenceTemperature     Float @default(8)
  entryProbabilityThreshold Float @default(60)
  exitProbabilityThreshold  Float @default(40)
  ambiguityMarginPct        Float @default(5)
  // Bir beacon'in son GERCEKTEN gecerli okumasindan sonra kac saniye daha
  // "hala guvenilir" sayilacagi (son bilinen EMA'si donmus halde salon
  // ortalamasina dahil edilmeye devam eder). Saha testinde bulunan gercek bir
  // hataya cozum: tek beacon'li bir salonun beacon'i 1-2 tur (rssi=0/outlier)
  // gecersiz okuma donduginde salon aninda adaylik disi kalip rakip salona
  // "isinlanma" (aninda EXIT+ENTRY) olusuyordu, cunku o an baska aday
  // olmadigindan rakip salon "tek aday" sayilip %100 kazaniyordu. Grace suresi
  // icindeki beacon, softmax karsilastirmasinda haklı rekabetini surdurur -
  // rakip gercekten daha guclu ise yine kaybeder, degilse sahte kazanc
  // olusmaz. Bkz. docs/decisions.md.
  staleGraceSeconds         Float @default(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  halls               Hall[]
  beacons             Beacon[]
  sessions            Session[]
  registrations       CongressRegistration[]
  registrationImports RegistrationImport[]
  venues              Venue[]
  announcements       Announcement[]
  sponsors            Sponsor[]
  keynoteSpeakers     KeynoteSpeaker[]
  infoSections        CongressInfoSection[]
  programImports      ProgramImport[]
}

enum VenueType {
  MAIN // kongre merkezi / ana mekan
  HOTEL // konaklama oteli
}

model Venue {
  id           String    @id @default(uuid())
  congressId   String
  type         VenueType @default(HOTEL)
  name         String
  address      String?   @db.Text
  city         String?
  phone        String?
  websiteUrl   String?
  mapUrl       String? // Google Maps baglantisi
  latitude     Float?
  longitude    Float?
  description  String?   @db.Text
  imageUrl     String?
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  congress Congress @relation(fields: [congressId], references: [id])

  @@index([congressId, type, displayOrder])
}

model Announcement {
  id          String    @id @default(uuid())
  congressId  String
  title       String
  body        String    @db.Text
  isPinned    Boolean   @default(false)
  // null = taslak, mobilde gorunmez. Push bildirimi bu fazda YOK (Faz 9) -
  // yalnizca icerik.
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  congress Congress @relation(fields: [congressId], references: [id])

  @@index([congressId, publishedAt])
}

enum SponsorTier {
  PLATINUM
  GOLD
  SILVER
  BRONZE
  SUPPORTER
}

model Sponsor {
  id           String      @id @default(uuid())
  congressId   String
  name         String
  tier         SponsorTier @default(SUPPORTER)
  logoUrl      String?
  websiteUrl   String?
  description  String?     @db.Text
  displayOrder Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  congress Congress @relation(fields: [congressId], references: [id])

  @@index([congressId, tier, displayOrder])
}

// Elle yonetilen bir VITRIN listesi - Faz 4'teki bilimsel program
// konusmaci/moderator isimleriyle (isim eslestirmeyle ele alinacak) KASITLI
// olarak bagli DEGIL, bkz. docs/decisions.md.
model KeynoteSpeaker {
  id           String   @id @default(uuid())
  congressId   String
  fullName     String // unvanli tam hali: "Prof. Dr. Ahmet Yilmaz"
  title        String? // "Kardiyoloji Profesoru"
  institution  String? // "Hacettepe Universitesi"
  country      String?
  bio          String?  @db.Text
  photoUrl     String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  congress Congress @relation(fields: [congressId], references: [id])

  @@index([congressId, displayOrder])
}

// Sabit alanlar yerine serbest bolumler secildi cunku her kongrenin "genel
// bilgi" icerigi farkli (biri "Ulasim" ister, biri "Duzenleme Kurulu").
// Icerik Markdown olarak saklanir, mobil tarafta render edilir.
model CongressInfoSection {
  id           String   @id @default(uuid())
  congressId   String
  title        String // "Kongre Hakkinda", "Ulasim", "Duzenleme Kurulu", "Kayit Bilgileri"
  body         String   @db.Text
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  congress Congress @relation(fields: [congressId], references: [id])

  @@index([congressId, displayOrder])
}

enum UserRole {
  PARTICIPANT
  ADMIN
}

model User {
  id                 String    @id @default(uuid())
  firstName          String
  lastName           String
  // Faz 4a: bilimsel program konusmaci/moderator eslestirmesi icin -
  // normalizeTurkishName(firstName + ' ' + lastName). Kullanici olusturulurken/
  // ad-soyadi guncellenirken hesaplanir (bkz. common/normalize-turkish-name.ts).
  // Nullable: Faz 4a ONCESI olusmus kayitlar icin migration ile geriye donuk
  // dolduruldu, ama sema seviyesinde NOT NULL zorunlu tutulmadi (gelecekte
  // farkli bir olusturma yolu bu adimi atlarsa sessizce hata vermesin diye).
  searchName         String?
  // Faz 1 oncesi tum kullanicilar icin doluydu (pilot-login eslestirmesi);
  // artik nullable - Faz 2'de dernek kayit listesinden e-postasi olup
  // telefonu olmayan katilimcilar gelecek. pilot-login bu alani hala her
  // zaman doldurur.
  phoneLast4         String?
  // E.164 normalize edilmis (ornek: +905321234567). unique oldugu ve E.164
  // bekledigi icin normalize EDILEMEYEN (unparseable) numaralar buraya
  // YAZILMAZ - yalnizca phoneRaw'da yasarlar (bkz. asagisi, veri kaybini
  // onleyen alan budur).
  email              String?   @unique
  phone              String?   @unique
  // Katilimcinin/dernegin verdigi HAM telefon hali - normalize edilebilmis
  // olsun ya da olmasin her zaman doldurulur. Panelde gosterilir, arama
  // buna da bakar. Bkz. docs/decisions.md (Faz 2 - phone + phoneRaw ikilisi).
  phoneRaw           String?
  passwordHash       String?
  // true ise kullanici gecici bir kodla/sifreyle giris yapmis demektir -
  // ActiveCongressGuard bu durumda kongre gerektiren uc noktalari kapatir.
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  role               UserRole  @default(PARTICIPANT)
  tokenVersion       Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  devices       Device[]
  registrations CongressRegistration[]

  observationBatches ObservationBatch[]
  beaconObservations BeaconObservation[]
  attendanceEvents   AttendanceEvent[]
  hallVisits         HallVisit[]
  presenceState      UserPresenceState?
  notificationLogs   NotificationLog[]
  programRoles       ProgramRole[]

  @@index([searchName])
}

enum RegistrationSource {
  API // dernek kayit sitesinden cekilen (Faz 2'de baglanacak)
  IMPORT // Excel/CSV yuklemesi
  MANUAL // panelden elle eklenen
  PILOT // eski pilot-login akisinin otomatik olusturdugu
}

model CongressRegistration {
  id           String             @id @default(uuid())
  userId       String
  congressId   String
  source       RegistrationSource @default(MANUAL)
  externalId   String? // dernek sistemindeki kayit numarasi
  isActive     Boolean            @default(true)
  registeredAt DateTime           @default(now())
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  congress Congress @relation(fields: [congressId], references: [id])

  @@unique([congressId, userId])
  @@index([congressId])
  @@index([userId])
}

enum ImportStatus {
  DRAFT // yuklendi, onay bekliyor
  APPROVED // onaylandi, kayitlara islendi
  CANCELLED // yetkili iptal etti
}

enum ImportRowStatus {
  NEW // yeni kullanici olusturulacak
  MATCHED // mevcut kullaniciyla eslesti, kaydi eklenecek/guncellenecek
  DUPLICATE // ayni dosya icinde tekrar eden satir
  INVALID // islenemez (bkz. RegistrationImportParser)
  EXCLUDED // yetkili elle cikardi
}

model RegistrationImport {
  id          String       @id @default(uuid())
  congressId  String
  adminUserId String
  fileName    String
  status      ImportStatus @default(DRAFT)
  totalRows   Int
  approvedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  congress  Congress                @relation(fields: [congressId], references: [id])
  adminUser AdminUser               @relation(fields: [adminUserId], references: [id])
  rows      RegistrationImportRow[]

  @@index([congressId, status])
}

model RegistrationImportRow {
  id              String          @id @default(uuid())
  importId        String
  rowNumber       Int // dosyadaki gercek satir numarasi (hata mesajlarinda kullanilir)
  rawFirstName    String?
  rawLastName     String?
  rawEmail        String?
  rawPhone        String?
  normalizedEmail String?
  // E.164; normalize edilemediyse null (rawPhone yine dolu - bkz. bolum 1).
  normalizedPhone String?
  externalId      String?
  status          ImportRowStatus
  // Satiri BLOKE eden hata - INVALID durumundaysa dolu, Turkce.
  message         String?
  // Satir islenebilir ama dikkat gerektiriyor - Turkce. message'dan AYRI:
  // biri satiri onaydan cikarir, digeri sadece bilgi verir.
  warning         String?
  matchedUserId   String?

  import RegistrationImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId, status])
}

enum DevicePlatform {
  IOS
  ANDROID
}

model Device {
  id          String         @id @default(uuid())
  userId      String
  platform    DevicePlatform
  deviceModel String?
  osVersion   String?
  appVersion  String?
  pushToken   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id])

  observationBatches ObservationBatch[]
  notificationLogs   NotificationLog[]

  @@index([userId])
}

model Hall {
  id            String   @id @default(uuid())
  congressId    String
  name          String
  rssiThreshold Int      @default(-70)
  // Salonun ayni anda kabul edebilecegi fiziksel kisi kapasitesi. Nullable -
  // mevcut salonlarda tahmini/sahte bir deger YAZILMAZ, migration sonrasi
  // hepsi null kalir. null = "kapasite tanimlanmamis" (0 ile KARISTIRILMAZ,
  // 0 zaten @Min(1) ile DTO seviyesinde reddedilir). Doluluk yuzdesi
  // hesaplamasi (icerideki/capacity*100) bu fazin kapsaminda DEGIL, yalnizca
  // veri modeli kuruluyor - bkz. docs/decisions.md.
  capacity      Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  congress    Congress     @relation(fields: [congressId], references: [id])
  hallBeacons HallBeacon[]

  attendanceEvents AttendanceEvent[]
  hallVisits       HallVisit[]
  sessions         Session[]

  @@index([congressId])
}

model Beacon {
  id         String   @id @default(uuid())
  congressId String
  uuid       String
  major      Int
  minor      Int
  label      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  congress    Congress     @relation(fields: [congressId], references: [id])
  hallBeacons HallBeacon[]

  beaconObservations BeaconObservation[]

  @@unique([congressId, uuid, major, minor])
}

model HallBeacon {
  id              String    @id @default(uuid())
  hallId          String
  beaconId        String
  isActive        Boolean   @default(true)
  installedAt     DateTime  @default(now())
  removedAt       DateTime?
  rssiThreshold   Int?
  calibrationNote String?
  placementNote   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  hall   Hall   @relation(fields: [hallId], references: [id])
  beacon Beacon @relation(fields: [beaconId], references: [id])

  @@index([hallId])
  @@index([beaconId])
}

model ObservationBatch {
  id             String   @id @default(uuid())
  clientBatchId  String
  deviceId       String
  userId         String
  receivedAt     DateTime @default(now())
  acceptedCount  Int
  duplicateCount Int
  rejectedCount  Int

  device             Device              @relation(fields: [deviceId], references: [id])
  user               User                @relation(fields: [userId], references: [id])
  beaconObservations BeaconObservation[]

  @@index([deviceId])
  @@index([userId])
}

model BeaconObservation {
  id               String   @id @default(uuid())
  observationId    String
  batchId          String
  userId           String
  congressId       String
  observedAt       DateTime
  serverReceivedAt DateTime @default(now())
  beaconId         String?
  uuid             String
  major            Int
  minor            Int
  rssi             Int
  txPower          Int?
  appVersion       String?
  createdAt        DateTime @default(now())

  batch  ObservationBatch @relation(fields: [batchId], references: [id])
  user   User             @relation(fields: [userId], references: [id])
  beacon Beacon?          @relation(fields: [beaconId], references: [id])

  @@unique([observationId, uuid, major, minor])
  @@index([userId, observedAt])
  @@index([beaconId])
}

enum AttendanceEventType {
  ENTRY
  EXIT
}

model AttendanceEvent {
  id     String              @id @default(uuid())
  userId String
  hallId String
  type   AttendanceEventType

  occurredAt       DateTime
  // v2'de ham dB marjini tasiyordu, v3'ten itibaren 0-100 arasi guven YUZDESI
  // tasir. Gecmis veri icin backfill YAPILMADI - algorithmVersion ayrimi
  // ('v2' vs 'v3') sayesinde eski/yeni anlam karismaz.
  confidenceScore  Float?
  // Karar gerekcesi: hangi salonlar, hangi yumusatilmis degerler, yuzdeler,
  // en yakin rakiple fark, kac okuma outlier diye elendi. Saha testinde
  // "neden burada yanlis salon secildi" sorusuna cevap verebilmek icin.
  decisionTrace    Json?
  algorithmVersion String
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  hall Hall @relation(fields: [hallId], references: [id])

  @@index([userId, occurredAt])
  @@index([hallId])
}

model HallVisit {
  id               String    @id @default(uuid())
  userId           String
  hallId           String
  startedAt        DateTime
  lastConfirmedAt  DateTime
  endedAt          DateTime?
  isOpen           Boolean   @default(true)
  confidenceLevel  String?
  algorithmVersion String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user          User               @relation(fields: [userId], references: [id])
  hall          Hall               @relation(fields: [hallId], references: [id])
  presenceState UserPresenceState?

  @@index([userId, startedAt])
  @@index([hallId])
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs           AuditLog[]
  registrationImports RegistrationImport[]
  programImports      ProgramImport[]
}

model AuditLog {
  id          String   @id @default(uuid())
  adminUserId String
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId, createdAt])
  @@index([entityType, entityId])
}

enum PresenceStatus {
  IN_HALL // net bir salonda, dogrulanmis
  AMBIGUOUS // iki (veya daha fazla) salon arasinda, yuzdeler birbirine cok yakin
  // NO_SIGNAL iki farkli gercekligi tek etikette birlestirir (bilincli
  // basitlestirme): (a) cihaz veri gonderiyor ama hicbir salon esigini/giris
  // yuzdesini gecmiyor - zayif sinyal, koridor, kalibrasyonsuz bolge;
  // (b) cihaz tamamen sessiz - Bluetooth kapali, uygulama durmus.
  // Ayrim kaybolmuyor: Takip Sagligi sayfasi lastObservationAt uzerinden
  // ikisini zaten ayiriyor (cihaz 'aktif'/'yakin_zamanda' iken NO_SIGNAL =
  // zayif sinyal; 'veri_yok' iken = sessiz cihaz).
  NO_SIGNAL
}

model UserPresenceState {
  userId              String         @id
  candidateHallId     String?
  candidateStreak     Int            @default(0)
  nonQualifyingStreak Int            @default(0)
  openHallVisitId     String?        @unique
  currentStatus       PresenceStatus @default(NO_SIGNAL)
  updatedAt           DateTime       @updatedAt

  user          User       @relation(fields: [userId], references: [id])
  openHallVisit HallVisit? @relation(fields: [openHallVisitId], references: [id])
}

model Session {
  id           String   @id @default(uuid())
  congressId   String
  hallId       String
  // Faz 4b canli testinde gercek bir kongre programinda VARCHAR(191)'i asan
  // iki dilli (TR/EN tek satirda birlesik) basliklarla karsilasildi - bkz.
  // docs/decisions.md. @db.Text'e genisletildi.
  title        String   @db.Text
  // DEPRECATED: yeni programlarda moderator/konusmaci ProgramRole uzerinden
  // tutulur (bkz. asagisi). Bu alan yalnizca Faz 4a ONCESI olusmus mevcut
  // verinin ve /sessions panelinin eski gorunumunun bozulmamasi icin
  // KORUNUYOR - silinmedi, yeni yazimlarda kullanilmasi beklenmiyor.
  speaker      String?
  startTime    DateTime
  endTime      DateTime
  description  String?
  // --- Faz 4a: iki seviyeli bilimsel program alanlari (hepsi nullable/
  // varsayilanli - mevcut oturumlar bozulmadan gecerli kalir) ---
  sessionType  String? // "Panel", "Sempozyum", "Kurs", "Ana Konusma", "Uydu Sempozyumu"
  dayLabel     String? // programdaki gun etiketi: "1. Gun", "Calistaylar"
  keywords     String? // virgulle ayrilmis anahtar kelimeler (Faz 9 bildirimleri icin hazirlik - bu fazda KULLANILMIYOR)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  congress Congress @relation(fields: [congressId], references: [id])
  hall     Hall     @relation(fields: [hallId], references: [id])

  presentations Presentation[]
  roles         ProgramRole[]

  notificationLogs NotificationLog[]

  @@index([congressId, startTime])
  @@index([hallId])
}

model Presentation {
  id           String    @id @default(uuid())
  sessionId    String
  title        String    @db.Text
  startTime    DateTime?
  endTime      DateTime?
  abstract     String?   @db.Text
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  session Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  roles   ProgramRole[]

  @@index([sessionId, displayOrder])
}

enum ProgramRoleType {
  MODERATOR // oturum baskani
  SPEAKER // konusmaci
  DISCUSSANT // tartismaci
}

enum RoleMatchStatus {
  MATCHED // otomatik eslesti (tek aday)
  AMBIGUOUS // birden fazla aday - yetkili secmeli
  UNMATCHED // aday yok
  MANUAL // yetkili elle bagladi
  IGNORED // yetkili "bu kisi katilimci degil" dedi
}

// Bir rol ya bir oturuma ya bir sunuma baglidir - ikisi birden dolu veya
// ikisi birden bos OLAMAZ. Prisma/MySQL seviyesinde CHECK kisiti
// yazilamadigi icin bu kural servis katmaninda (ProgramRoleService)
// dogrulanir, bkz. docs/decisions.md "neden tek ProgramRole tablosu".
model ProgramRole {
  id             String          @id @default(uuid())
  sessionId      String?
  presentationId String?
  type           ProgramRoleType
  rawName        String // programda yazdigi hali: "Prof. Dr. Ahmet Yilmaz"
  searchName     String // normalizeTurkishName(rawName)
  userId         String? // eslesen katilimci
  matchStatus    RoleMatchStatus @default(UNMATCHED)
  displayOrder   Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  session      Session?      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  presentation Presentation? @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id])

  @@index([sessionId])
  @@index([presentationId])
  @@index([searchName])
  @@index([userId])
}

enum ProgramSourceType {
  PDF
  EXCEL
}

enum ProgramImportStatus {
  PENDING // dosya alindi, cikarim kuyruga girdi
  EXTRACTING // LLM cagrisi suruyor
  DRAFT // cikarim bitti, yetkili onayi bekliyor
  APPROVED // canliya islendi
  CANCELLED
  FAILED // cikarim basarisiz (errorMessage dolu)
}

// LLM'in ham cikarimini tutan STAGING katmani (Faz 2'nin RegistrationImport
// deseniyle ayni fikir: yukle -> onizle/duzelt -> onayla). Onaylanmadan
// hicbir satir canli Session/Presentation/ProgramRole tablolarina yazilmaz.
model ProgramImport {
  id               String              @id @default(uuid())
  congressId       String
  adminUserId      String
  fileName         String
  sourceType       ProgramSourceType
  status           ProgramImportStatus @default(PENDING)
  model            String? // gercekte kullanilan model kimligi (env ANTHROPIC_MODEL o an ne ise)
  inputTokens      Int?
  outputTokens     Int?
  estimatedCostUsd Float? // kayit aninda MODEL_PRICING ile hesaplanmis gercek maliyet
  pageCount        Int?
  errorMessage     String?             @db.Text
  approvedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  congress  Congress               @relation(fields: [congressId], references: [id])
  adminUser AdminUser              @relation(fields: [adminUserId], references: [id])
  sessions  ProgramImportSession[]

  @@index([congressId, status])
}

// Faz 2'nin ImportRowStatus enum'u yeniden kullanilir (NEW/INVALID/EXCLUDED
// bu baglamda da ayni anlami tasir: NEW = onaya hazir, INVALID = baslik
// yoksa/kritik hata, EXCLUDED = yetkili elle cikardi).
model ProgramImportSession {
  id           String          @id @default(uuid())
  importId     String
  rowOrder     Int
  // Faz 4b canli testinde gercek bir kongre programinda VARCHAR(191)'i asan
  // iki dilli (TR/EN tek satirda birlesik) basliklarla karsilasildi - bkz.
  // docs/decisions.md. @db.Text'e genisletildi (canli Session.title ile ayni).
  title        String?         @db.Text
  rawHallName  String? // belgede yazan salon adi
  hallId       String? // eslesen Hall (backend hesaplar, bkz. hall-matching.ts)
  dayLabel     String?
  rawDate      String? // belgede yazan tarih metni, varsa
  rawStartTime String? // "09:00"
  rawEndTime   String?
  startTime    DateTime? // backend hesaplar (bkz. derive-datetime.ts)
  endTime      DateTime?
  sessionType  String?
  keywords     String?
  status       ImportRowStatus
  message      String? // status=INVALID oldugunda neden
  warning      String? // islenebilir ama dikkat gerektiriyor (ornek: tarih kongre baslangicindan turetildi)

  import        ProgramImport               @relation(fields: [importId], references: [id], onDelete: Cascade)
  presentations ProgramImportPresentation[]
  roles         ProgramImportRole[]

  @@index([importId, rowOrder])
}

model ProgramImportPresentation {
  id              String    @id @default(uuid())
  importSessionId String
  rowOrder        Int
  title           String?   @db.Text
  rawStartTime    String?
  rawEndTime      String?
  startTime       DateTime?
  endTime         DateTime?
  abstract        String?   @db.Text
  warning         String?

  importSession ProgramImportSession @relation(fields: [importSessionId], references: [id], onDelete: Cascade)
  roles         ProgramImportRole[]

  @@index([importSessionId, rowOrder])
}

// Faz 4a'daki ProgramRole ile AYNI "ya oturuma ya sunuma, ikisi birden
// degil" kurali burada da servis katmaninda dogrulanir. previewMatchStatus/
// previewUserId onayda oldugu gibi canli ProgramRole'e tasinir - yeni bir
// eslestirme calismasi yapilmaz, Faz 4a'nin matchRole() servisi cagrilir.
model ProgramImportRole {
  id                   String          @id @default(uuid())
  importSessionId      String?
  importPresentationId String?
  type                 ProgramRoleType
  rawName              String
  searchName           String
  previewMatchStatus   RoleMatchStatus
  previewUserId        String?

  importSession      ProgramImportSession?      @relation(fields: [importSessionId], references: [id], onDelete: Cascade)
  importPresentation ProgramImportPresentation? @relation(fields: [importPresentationId], references: [id], onDelete: Cascade)

  @@index([importSessionId])
  @@index([importPresentationId])
}

enum NotificationStatus {
  SENT
  FAILED
}

model NotificationLog {
  id        String             @id @default(uuid())
  sessionId String?
  userId    String
  deviceId  String
  title     String
  body      String
  status    NotificationStatus
  sentAt    DateTime           @default(now())
  openedAt  DateTime?

  session Session? @relation(fields: [sessionId], references: [id])
  user    User     @relation(fields: [userId], references: [id])
  device  Device   @relation(fields: [deviceId], references: [id])

  @@index([userId])
  @@index([sessionId])
}
