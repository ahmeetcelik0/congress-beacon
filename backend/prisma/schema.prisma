// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model Congress {
  id                         String    @id @default(uuid())
  name                       String
  code                       String    @unique
  accessCode                 String
  beaconUuid                 String
  startDate                  DateTime?
  endDate                    DateTime?
  // Mobil ana sayfa kongre karti icin Faz 3 alanlari - hepsi nullable,
  // mevcut kongreler (bu alanlar hic doldurulmadan) bozulmasin diye.
  // `name` kisa/etiket adi olarak KALIYOR (kod/URL/panel listelerinde
  // kullanilir); `fullName` resmi tam addir (mobil kartta gosterilir).
  fullName                   String?
  description                String?   @db.Text
  coverImageUrl              String?
  websiteUrl                 String?
  contactEmail               String?
  contactPhone               String?
  // Mobil cihazlarin observation batch'lerini kac saniyede bir gonderecegini
  // belirler. Panelden degistirilebilir; mobil uygulama bunu koda gomulu
  // sabit yerine her batch gonderiminde backend'den ogrenir (bkz.
  // POST /observations/batch response'u).
  observationIntervalSeconds Int       @default(10)

  // Salon tespit algoritmasi v3 ayarlari. Ayri bir AlgorithmConfig tablosu
  // KURULMUYOR - proje zaten kongre-bazli ayar desenini (yukaridaki
  // observationIntervalSeconds) kullaniyor; bu olcekte ayri bir tablo erken
  // karmasiklik olurdu. Saha kalibrasyonunda panelden ince ayar yapilir.
  emaAlpha                  Float @default(0.35)
  hampelK                   Float @default(3)
  hampelWindowSize          Int   @default(5)
  confidenceTemperature     Float @default(8)
  entryProbabilityThreshold Float @default(60)
  exitProbabilityThreshold  Float @default(40)
  ambiguityMarginPct        Float @default(5)
  // Bir beacon'in son GERCEKTEN gecerli okumasindan sonra kac saniye daha
  // "hala guvenilir" sayilacagi (son bilinen EMA'si donmus halde salon
  // ortalamasina dahil edilmeye devam eder). Saha testinde bulunan gercek bir
  // hataya cozum: tek beacon'li bir salonun beacon'i 1-2 tur (rssi=0/outlier)
  // gecersiz okuma donduginde salon aninda adaylik disi kalip rakip salona
  // "isinlanma" (aninda EXIT+ENTRY) olusuyordu, cunku o an baska aday
  // olmadigindan rakip salon "tek aday" sayilip %100 kazaniyordu. Grace suresi
  // icindeki beacon, softmax karsilastirmasinda haklı rekabetini surdurur -
  // rakip gercekten daha guclu ise yine kaybeder, degilse sahte kazanc
  // olusmaz. Bkz. docs/decisions.md.
  staleGraceSeconds         Float @default(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  halls               Hall[]
  beacons             Beacon[]
  sessions            Session[]
  registrations       CongressRegistration[]
  registrationImports RegistrationImport[]
  venues              Venue[]
  announcements       Announcement[]
  sponsors            Sponsor[]
  keynoteSpeakers     KeynoteSpeaker[]
  infoSections        CongressInfoSection[]
}

enum VenueType {
  MAIN // kongre merkezi / ana mekan
  HOTEL // konaklama oteli
}

model Venue {
  id           String    @id @default(uuid())
  congressId   String
  type         VenueType @default(HOTEL)
  name         String
  address      String?   @db.Text
  city         String?
  phone        String?
  websiteUrl   String?
  mapUrl       String? // Google Maps baglantisi
  latitude     Float?
  longitude    Float?
  description  String?   @db.Text
  imageUrl     String?
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  congress Congress @relation(fields: [congressId], references: [id])

  @@index([congressId, type, displayOrder])
}

model Announcement {
  id          String    @id @default(uuid())
  congressId  String
  title       String
  body        String    @db.Text
  isPinned    Boolean   @default(false)
  // null = taslak, mobilde gorunmez. Push bildirimi bu fazda YOK (Faz 9) -
  // yalnizca icerik.
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  congress Congress @relation(fields: [congressId], references: [id])

  @@index([congressId, publishedAt])
}

enum SponsorTier {
  PLATINUM
  GOLD
  SILVER
  BRONZE
  SUPPORTER
}

model Sponsor {
  id           String      @id @default(uuid())
  congressId   String
  name         String
  tier         SponsorTier @default(SUPPORTER)
  logoUrl      String?
  websiteUrl   String?
  description  String?     @db.Text
  displayOrder Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  congress Congress @relation(fields: [congressId], references: [id])

  @@index([congressId, tier, displayOrder])
}

// Elle yonetilen bir VITRIN listesi - Faz 4'teki bilimsel program
// konusmaci/moderator isimleriyle (isim eslestirmeyle ele alinacak) KASITLI
// olarak bagli DEGIL, bkz. docs/decisions.md.
model KeynoteSpeaker {
  id           String   @id @default(uuid())
  congressId   String
  fullName     String // unvanli tam hali: "Prof. Dr. Ahmet Yilmaz"
  title        String? // "Kardiyoloji Profesoru"
  institution  String? // "Hacettepe Universitesi"
  country      String?
  bio          String?  @db.Text
  photoUrl     String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  congress Congress @relation(fields: [congressId], references: [id])

  @@index([congressId, displayOrder])
}

// Sabit alanlar yerine serbest bolumler secildi cunku her kongrenin "genel
// bilgi" icerigi farkli (biri "Ulasim" ister, biri "Duzenleme Kurulu").
// Icerik Markdown olarak saklanir, mobil tarafta render edilir.
model CongressInfoSection {
  id           String   @id @default(uuid())
  congressId   String
  title        String // "Kongre Hakkinda", "Ulasim", "Duzenleme Kurulu", "Kayit Bilgileri"
  body         String   @db.Text
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  congress Congress @relation(fields: [congressId], references: [id])

  @@index([congressId, displayOrder])
}

enum UserRole {
  PARTICIPANT
  ADMIN
}

model User {
  id                 String    @id @default(uuid())
  firstName          String
  lastName           String
  // Faz 1 oncesi tum kullanicilar icin doluydu (pilot-login eslestirmesi);
  // artik nullable - Faz 2'de dernek kayit listesinden e-postasi olup
  // telefonu olmayan katilimcilar gelecek. pilot-login bu alani hala her
  // zaman doldurur.
  phoneLast4         String?
  // E.164 normalize edilmis (ornek: +905321234567). unique oldugu ve E.164
  // bekledigi icin normalize EDILEMEYEN (unparseable) numaralar buraya
  // YAZILMAZ - yalnizca phoneRaw'da yasarlar (bkz. asagisi, veri kaybini
  // onleyen alan budur).
  email              String?   @unique
  phone              String?   @unique
  // Katilimcinin/dernegin verdigi HAM telefon hali - normalize edilebilmis
  // olsun ya da olmasin her zaman doldurulur. Panelde gosterilir, arama
  // buna da bakar. Bkz. docs/decisions.md (Faz 2 - phone + phoneRaw ikilisi).
  phoneRaw           String?
  passwordHash       String?
  // true ise kullanici gecici bir kodla/sifreyle giris yapmis demektir -
  // ActiveCongressGuard bu durumda kongre gerektiren uc noktalari kapatir.
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  role               UserRole  @default(PARTICIPANT)
  tokenVersion       Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  devices       Device[]
  registrations CongressRegistration[]

  observationBatches ObservationBatch[]
  beaconObservations BeaconObservation[]
  attendanceEvents   AttendanceEvent[]
  hallVisits         HallVisit[]
  presenceState      UserPresenceState?
  notificationLogs   NotificationLog[]
}

enum RegistrationSource {
  API // dernek kayit sitesinden cekilen (Faz 2'de baglanacak)
  IMPORT // Excel/CSV yuklemesi
  MANUAL // panelden elle eklenen
  PILOT // eski pilot-login akisinin otomatik olusturdugu
}

model CongressRegistration {
  id           String             @id @default(uuid())
  userId       String
  congressId   String
  source       RegistrationSource @default(MANUAL)
  externalId   String? // dernek sistemindeki kayit numarasi
  isActive     Boolean            @default(true)
  registeredAt DateTime           @default(now())
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  congress Congress @relation(fields: [congressId], references: [id])

  @@unique([congressId, userId])
  @@index([congressId])
  @@index([userId])
}

enum ImportStatus {
  DRAFT // yuklendi, onay bekliyor
  APPROVED // onaylandi, kayitlara islendi
  CANCELLED // yetkili iptal etti
}

enum ImportRowStatus {
  NEW // yeni kullanici olusturulacak
  MATCHED // mevcut kullaniciyla eslesti, kaydi eklenecek/guncellenecek
  DUPLICATE // ayni dosya icinde tekrar eden satir
  INVALID // islenemez (bkz. RegistrationImportParser)
  EXCLUDED // yetkili elle cikardi
}

model RegistrationImport {
  id          String       @id @default(uuid())
  congressId  String
  adminUserId String
  fileName    String
  status      ImportStatus @default(DRAFT)
  totalRows   Int
  approvedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  congress  Congress                @relation(fields: [congressId], references: [id])
  adminUser AdminUser               @relation(fields: [adminUserId], references: [id])
  rows      RegistrationImportRow[]

  @@index([congressId, status])
}

model RegistrationImportRow {
  id              String          @id @default(uuid())
  importId        String
  rowNumber       Int // dosyadaki gercek satir numarasi (hata mesajlarinda kullanilir)
  rawFirstName    String?
  rawLastName     String?
  rawEmail        String?
  rawPhone        String?
  normalizedEmail String?
  // E.164; normalize edilemediyse null (rawPhone yine dolu - bkz. bolum 1).
  normalizedPhone String?
  externalId      String?
  status          ImportRowStatus
  // Satiri BLOKE eden hata - INVALID durumundaysa dolu, Turkce.
  message         String?
  // Satir islenebilir ama dikkat gerektiriyor - Turkce. message'dan AYRI:
  // biri satiri onaydan cikarir, digeri sadece bilgi verir.
  warning         String?
  matchedUserId   String?

  import RegistrationImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId, status])
}

enum DevicePlatform {
  IOS
  ANDROID
}

model Device {
  id          String         @id @default(uuid())
  userId      String
  platform    DevicePlatform
  deviceModel String?
  osVersion   String?
  appVersion  String?
  pushToken   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id])

  observationBatches ObservationBatch[]
  notificationLogs   NotificationLog[]

  @@index([userId])
}

model Hall {
  id            String   @id @default(uuid())
  congressId    String
  name          String
  rssiThreshold Int      @default(-70)
  // Salonun ayni anda kabul edebilecegi fiziksel kisi kapasitesi. Nullable -
  // mevcut salonlarda tahmini/sahte bir deger YAZILMAZ, migration sonrasi
  // hepsi null kalir. null = "kapasite tanimlanmamis" (0 ile KARISTIRILMAZ,
  // 0 zaten @Min(1) ile DTO seviyesinde reddedilir). Doluluk yuzdesi
  // hesaplamasi (icerideki/capacity*100) bu fazin kapsaminda DEGIL, yalnizca
  // veri modeli kuruluyor - bkz. docs/decisions.md.
  capacity      Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  congress    Congress     @relation(fields: [congressId], references: [id])
  hallBeacons HallBeacon[]

  attendanceEvents AttendanceEvent[]
  hallVisits       HallVisit[]
  sessions         Session[]

  @@index([congressId])
}

model Beacon {
  id         String   @id @default(uuid())
  congressId String
  uuid       String
  major      Int
  minor      Int
  label      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  congress    Congress     @relation(fields: [congressId], references: [id])
  hallBeacons HallBeacon[]

  beaconObservations BeaconObservation[]

  @@unique([congressId, uuid, major, minor])
}

model HallBeacon {
  id              String    @id @default(uuid())
  hallId          String
  beaconId        String
  isActive        Boolean   @default(true)
  installedAt     DateTime  @default(now())
  removedAt       DateTime?
  rssiThreshold   Int?
  calibrationNote String?
  placementNote   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  hall   Hall   @relation(fields: [hallId], references: [id])
  beacon Beacon @relation(fields: [beaconId], references: [id])

  @@index([hallId])
  @@index([beaconId])
}

model ObservationBatch {
  id             String   @id @default(uuid())
  clientBatchId  String
  deviceId       String
  userId         String
  receivedAt     DateTime @default(now())
  acceptedCount  Int
  duplicateCount Int
  rejectedCount  Int

  device             Device              @relation(fields: [deviceId], references: [id])
  user               User                @relation(fields: [userId], references: [id])
  beaconObservations BeaconObservation[]

  @@index([deviceId])
  @@index([userId])
}

model BeaconObservation {
  id               String   @id @default(uuid())
  observationId    String
  batchId          String
  userId           String
  congressId       String
  observedAt       DateTime
  serverReceivedAt DateTime @default(now())
  beaconId         String?
  uuid             String
  major            Int
  minor            Int
  rssi             Int
  txPower          Int?
  appVersion       String?
  createdAt        DateTime @default(now())

  batch  ObservationBatch @relation(fields: [batchId], references: [id])
  user   User             @relation(fields: [userId], references: [id])
  beacon Beacon?          @relation(fields: [beaconId], references: [id])

  @@unique([observationId, uuid, major, minor])
  @@index([userId, observedAt])
  @@index([beaconId])
}

enum AttendanceEventType {
  ENTRY
  EXIT
}

model AttendanceEvent {
  id     String              @id @default(uuid())
  userId String
  hallId String
  type   AttendanceEventType

  occurredAt       DateTime
  // v2'de ham dB marjini tasiyordu, v3'ten itibaren 0-100 arasi guven YUZDESI
  // tasir. Gecmis veri icin backfill YAPILMADI - algorithmVersion ayrimi
  // ('v2' vs 'v3') sayesinde eski/yeni anlam karismaz.
  confidenceScore  Float?
  // Karar gerekcesi: hangi salonlar, hangi yumusatilmis degerler, yuzdeler,
  // en yakin rakiple fark, kac okuma outlier diye elendi. Saha testinde
  // "neden burada yanlis salon secildi" sorusuna cevap verebilmek icin.
  decisionTrace    Json?
  algorithmVersion String
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  hall Hall @relation(fields: [hallId], references: [id])

  @@index([userId, occurredAt])
  @@index([hallId])
}

model HallVisit {
  id               String    @id @default(uuid())
  userId           String
  hallId           String
  startedAt        DateTime
  lastConfirmedAt  DateTime
  endedAt          DateTime?
  isOpen           Boolean   @default(true)
  confidenceLevel  String?
  algorithmVersion String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user          User               @relation(fields: [userId], references: [id])
  hall          Hall               @relation(fields: [hallId], references: [id])
  presenceState UserPresenceState?

  @@index([userId, startedAt])
  @@index([hallId])
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs           AuditLog[]
  registrationImports RegistrationImport[]
}

model AuditLog {
  id          String   @id @default(uuid())
  adminUserId String
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId, createdAt])
  @@index([entityType, entityId])
}

enum PresenceStatus {
  IN_HALL // net bir salonda, dogrulanmis
  AMBIGUOUS // iki (veya daha fazla) salon arasinda, yuzdeler birbirine cok yakin
  // NO_SIGNAL iki farkli gercekligi tek etikette birlestirir (bilincli
  // basitlestirme): (a) cihaz veri gonderiyor ama hicbir salon esigini/giris
  // yuzdesini gecmiyor - zayif sinyal, koridor, kalibrasyonsuz bolge;
  // (b) cihaz tamamen sessiz - Bluetooth kapali, uygulama durmus.
  // Ayrim kaybolmuyor: Takip Sagligi sayfasi lastObservationAt uzerinden
  // ikisini zaten ayiriyor (cihaz 'aktif'/'yakin_zamanda' iken NO_SIGNAL =
  // zayif sinyal; 'veri_yok' iken = sessiz cihaz).
  NO_SIGNAL
}

model UserPresenceState {
  userId              String         @id
  candidateHallId     String?
  candidateStreak     Int            @default(0)
  nonQualifyingStreak Int            @default(0)
  openHallVisitId     String?        @unique
  currentStatus       PresenceStatus @default(NO_SIGNAL)
  updatedAt           DateTime       @updatedAt

  user          User       @relation(fields: [userId], references: [id])
  openHallVisit HallVisit? @relation(fields: [openHallVisitId], references: [id])
}

model Session {
  id          String   @id @default(uuid())
  congressId  String
  hallId      String
  title       String
  speaker     String?
  startTime   DateTime
  endTime     DateTime
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  congress Congress @relation(fields: [congressId], references: [id])
  hall     Hall     @relation(fields: [hallId], references: [id])

  notificationLogs NotificationLog[]

  @@index([congressId, startTime])
  @@index([hallId])
}

enum NotificationStatus {
  SENT
  FAILED
}

model NotificationLog {
  id        String             @id @default(uuid())
  sessionId String?
  userId    String
  deviceId  String
  title     String
  body      String
  status    NotificationStatus
  sentAt    DateTime           @default(now())
  openedAt  DateTime?

  session Session? @relation(fields: [sessionId], references: [id])
  user    User     @relation(fields: [userId], references: [id])
  device  Device   @relation(fields: [deviceId], references: [id])

  @@index([userId])
  @@index([sessionId])
}
