// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model Congress {
  id         String    @id @default(uuid())
  name       String
  code       String    @unique
  accessCode String
  beaconUuid String
  startDate  DateTime?
  endDate    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  halls   Hall[]
  beacons Beacon[]
  users   User[]
}

enum UserRole {
  PARTICIPANT
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  congressId   String
  firstName    String
  lastName     String
  phoneLast4   String
  role         UserRole @default(PARTICIPANT)
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  congress Congress @relation(fields: [congressId], references: [id])
  devices  Device[]

  @@unique([congressId, firstName, lastName, phoneLast4])
}

enum DevicePlatform {
  IOS
  ANDROID
}

model Device {
  id          String         @id @default(uuid())
  userId      String
  platform    DevicePlatform
  deviceModel String?
  osVersion   String?
  appVersion  String?
  pushToken   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Hall {
  id            String   @id @default(uuid())
  congressId    String
  name          String
  rssiThreshold Int      @default(-70)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  congress    Congress     @relation(fields: [congressId], references: [id])
  hallBeacons HallBeacon[]

  @@index([congressId])
}

model Beacon {
  id         String   @id @default(uuid())
  congressId String
  uuid       String
  major      Int
  minor      Int
  label      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  congress    Congress     @relation(fields: [congressId], references: [id])
  hallBeacons HallBeacon[]

  @@unique([congressId, uuid, major, minor])
}

model HallBeacon {
  id              String    @id @default(uuid())
  hallId          String
  beaconId        String
  isActive        Boolean   @default(true)
  installedAt     DateTime  @default(now())
  removedAt       DateTime?
  rssiThreshold   Int?
  calibrationNote String?
  placementNote   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  hall   Hall   @relation(fields: [hallId], references: [id])
  beacon Beacon @relation(fields: [beaconId], references: [id])

  @@index([hallId])
  @@index([beaconId])
}
