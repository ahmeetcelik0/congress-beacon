// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model Congress {
  id         String    @id @default(uuid())
  name       String
  code       String    @unique
  accessCode String
  beaconUuid String
  startDate  DateTime?
  endDate    DateTime?
  // Mobil cihazlarin observation batch'lerini kac saniyede bir gonderecegini
  // belirler. Panelden degistirilebilir; mobil uygulama bunu koda gomulu
  // sabit yerine her batch gonderiminde backend'den ogrenir (bkz.
  // POST /observations/batch response'u).
  observationIntervalSeconds Int       @default(10)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  halls    Hall[]
  beacons  Beacon[]
  users    User[]
  sessions Session[]
}

enum UserRole {
  PARTICIPANT
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  congressId   String
  firstName    String
  lastName     String
  phoneLast4   String
  role         UserRole @default(PARTICIPANT)
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  congress Congress @relation(fields: [congressId], references: [id])
  devices  Device[]

  observationBatches ObservationBatch[]
  beaconObservations BeaconObservation[]
  attendanceEvents   AttendanceEvent[]
  hallVisits         HallVisit[]
  presenceState      UserPresenceState?
  notificationLogs   NotificationLog[]

  @@unique([congressId, firstName, lastName, phoneLast4])
}

enum DevicePlatform {
  IOS
  ANDROID
}

model Device {
  id          String         @id @default(uuid())
  userId      String
  platform    DevicePlatform
  deviceModel String?
  osVersion   String?
  appVersion  String?
  pushToken   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id])

  observationBatches ObservationBatch[]
  notificationLogs   NotificationLog[]

  @@index([userId])
}

model Hall {
  id            String   @id @default(uuid())
  congressId    String
  name          String
  rssiThreshold Int      @default(-70)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  congress    Congress     @relation(fields: [congressId], references: [id])
  hallBeacons HallBeacon[]

  attendanceEvents AttendanceEvent[]
  hallVisits       HallVisit[]
  sessions         Session[]

  @@index([congressId])
}

model Beacon {
  id         String   @id @default(uuid())
  congressId String
  uuid       String
  major      Int
  minor      Int
  label      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  congress    Congress     @relation(fields: [congressId], references: [id])
  hallBeacons HallBeacon[]

  beaconObservations BeaconObservation[]

  @@unique([congressId, uuid, major, minor])
}

model HallBeacon {
  id              String    @id @default(uuid())
  hallId          String
  beaconId        String
  isActive        Boolean   @default(true)
  installedAt     DateTime  @default(now())
  removedAt       DateTime?
  rssiThreshold   Int?
  calibrationNote String?
  placementNote   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  hall   Hall   @relation(fields: [hallId], references: [id])
  beacon Beacon @relation(fields: [beaconId], references: [id])

  @@index([hallId])
  @@index([beaconId])
}

model ObservationBatch {
  id             String   @id @default(uuid())
  clientBatchId  String
  deviceId       String
  userId         String
  receivedAt     DateTime @default(now())
  acceptedCount  Int
  duplicateCount Int
  rejectedCount  Int

  device             Device              @relation(fields: [deviceId], references: [id])
  user               User                @relation(fields: [userId], references: [id])
  beaconObservations BeaconObservation[]

  @@index([deviceId])
  @@index([userId])
}

model BeaconObservation {
  id               String   @id @default(uuid())
  observationId    String
  batchId          String
  userId           String
  congressId       String
  observedAt       DateTime
  serverReceivedAt DateTime @default(now())
  beaconId         String?
  uuid             String
  major            Int
  minor            Int
  rssi             Int
  txPower          Int?
  appVersion       String?
  createdAt        DateTime @default(now())

  batch  ObservationBatch @relation(fields: [batchId], references: [id])
  user   User             @relation(fields: [userId], references: [id])
  beacon Beacon?          @relation(fields: [beaconId], references: [id])

  @@unique([observationId, uuid, major, minor])
  @@index([userId, observedAt])
  @@index([beaconId])
}

enum AttendanceEventType {
  ENTRY
  EXIT
}

model AttendanceEvent {
  id               String              @id @default(uuid())
  userId           String
  hallId           String
  type             AttendanceEventType
  occurredAt       DateTime
  confidenceScore  Float?
  algorithmVersion String
  createdAt        DateTime            @default(now())

  user User @relation(fields: [userId], references: [id])
  hall Hall @relation(fields: [hallId], references: [id])

  @@index([userId, occurredAt])
  @@index([hallId])
}

model HallVisit {
  id               String    @id @default(uuid())
  userId           String
  hallId           String
  startedAt        DateTime
  lastConfirmedAt  DateTime
  endedAt          DateTime?
  isOpen           Boolean   @default(true)
  confidenceLevel  String?
  algorithmVersion String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user          User               @relation(fields: [userId], references: [id])
  hall          Hall               @relation(fields: [hallId], references: [id])
  presenceState UserPresenceState?

  @@index([userId, startedAt])
  @@index([hallId])
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs AuditLog[]
}

model AuditLog {
  id          String   @id @default(uuid())
  adminUserId String
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId, createdAt])
  @@index([entityType, entityId])
}

model UserPresenceState {
  userId              String   @id
  candidateHallId     String?
  candidateStreak     Int      @default(0)
  nonQualifyingStreak Int      @default(0)
  openHallVisitId     String?  @unique
  updatedAt           DateTime @updatedAt

  user          User       @relation(fields: [userId], references: [id])
  openHallVisit HallVisit? @relation(fields: [openHallVisitId], references: [id])
}

model Session {
  id          String   @id @default(uuid())
  congressId  String
  hallId      String
  title       String
  speaker     String?
  startTime   DateTime
  endTime     DateTime
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  congress Congress @relation(fields: [congressId], references: [id])
  hall     Hall     @relation(fields: [hallId], references: [id])

  notificationLogs NotificationLog[]

  @@index([congressId, startTime])
  @@index([hallId])
}

enum NotificationStatus {
  SENT
  FAILED
}

model NotificationLog {
  id        String              @id @default(uuid())
  sessionId String?
  userId    String
  deviceId  String
  title     String
  body      String
  status    NotificationStatus
  sentAt    DateTime            @default(now())
  openedAt  DateTime?

  session Session? @relation(fields: [sessionId], references: [id])
  user    User     @relation(fields: [userId], references: [id])
  device  Device   @relation(fields: [deviceId], references: [id])

  @@index([userId])
  @@index([sessionId])
}
