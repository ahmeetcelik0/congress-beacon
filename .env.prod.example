# Production ortam degiskenleri sablonu.
# Sunucuda bu dosyayi ".env.prod" olarak kopyala ve TUM degerleri
# gercek/guclu degerlerle degistir. ".env.prod" asla git'e commit edilmez.

MYSQL_ROOT_PASSWORD=changeme-guclu-bir-sifre-yaz
MYSQL_DATABASE=congress_beacon
MYSQL_USER=congress_beacon
MYSQL_PASSWORD=changeme-guclu-bir-sifre-yaz

# openssl rand -hex 32 komutuyla rastgele, guclu bir deger uretebilirsin
JWT_SECRET=changeme-rastgele-uzun-bir-deger

# SMTP (Faz 1 - dogrulama kodu e-postasi). Bos birakilirsa gonderim
# YAPILMAZ, kod yalnizca sunucu loguna yazilir - production'da mutlaka
# gercek degerlerle doldurulmali.
# Faz 10 dogrulama turu: Brevo secildi, auth.photofocustr.com ALT ALAN
# ADI dogrulandi (DKIM/SPF/DMARC yayilmis durumda) - kok photofocustr.com
# DEGIL. Baska bir saglayiciya gecilirse bu deger degisir.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=changeme-brevo-smtp-kullanici
SMTP_PASS=changeme-brevo-smtp-anahtari
MAIL_FROM="Kongre Beacon <no-reply@auth.photofocustr.com>"
# Faz 10: kod e-postasindaki Reply-To - GERCEK bir destek adresi olmali
# (bkz. docs/decisions.md "Faz 10"). Bos birakilirsa MAIL_FROM'a duser.
MAIL_REPLY_TO=destek@photofocustr.com

# Faz 4b - PDF/Excel'den bilimsel program cikarimi (Claude API). Bos
# birakilirsa program cikarimi uc noktalari 503 doner, geri kalan uygulama
# etkilenmez. Bkz. DEPLOY-REHBERI.md SS9.7.
ANTHROPIC_API_KEY=changeme-anthropic-api-anahtari
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_MAX_OUTPUT_TOKENS=128000

# Faz 5 - mobil okuma API'lerinde gorsel URL'lerini (kapak, logo, fotograf)
# mutlak hale getirmek icin kullanilir - production'da MUTLAKA doldurulmali
# (bkz. backend/.env.example, common/absolute-url.ts).
APP_PUBLIC_URL=https://beacon.photofocustr.com/api

# Faz 9 - push bildirimleri (FCM). Firebase Console > Proje Ayarlari >
# Servis Hesaplari > "Yeni ozel anahtar olustur" ile indirilen JSON
# dosyasinin TAM ICERIGI, TEK SATIRDA (dosya yolu DEGIL, iceriğin kendisi).
# Bos birakilirsa push bildirimleri sessizce devre disi kalir (loglanir,
# gonderilmez) - uygulama COKMEZ, ama kullanicilar bildirim ALMAZ. Bu
# deger GERCEK bir kimlik bilgisidir - ".env.prod" gibi git'e commit
# EDILMEYEN bir dosyada tutulmali (bkz. DEPLOY-REHBERI.md).
FIREBASE_SERVICE_ACCOUNT_JSON=changeme-firebase-service-account-json-tek-satir
