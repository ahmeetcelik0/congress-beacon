# Production ortam degiskenleri sablonu.
# Sunucuda bu dosyayi ".env.prod" olarak kopyala ve TUM degerleri
# gercek/guclu degerlerle degistir. ".env.prod" asla git'e commit edilmez.

MYSQL_ROOT_PASSWORD=changeme-guclu-bir-sifre-yaz
MYSQL_DATABASE=congress_beacon
MYSQL_USER=congress_beacon
MYSQL_PASSWORD=changeme-guclu-bir-sifre-yaz

# openssl rand -hex 32 komutuyla rastgele, guclu bir deger uretebilirsin
JWT_SECRET=changeme-rastgele-uzun-bir-deger

# SMTP (Faz 1 - dogrulama kodu e-postasi). Bos birakilirsa gonderim
# YAPILMAZ, kod yalnizca sunucu loguna yazilir - production'da mutlaka
# gercek degerlerle doldurulmali.
SMTP_HOST=changeme-smtp-sunucusu
SMTP_PORT=587
SMTP_USER=changeme-smtp-kullanici
SMTP_PASS=changeme-smtp-sifre
MAIL_FROM=no-reply@congress-beacon.example

# Faz 4b - PDF/Excel'den bilimsel program cikarimi (Claude API). Bos
# birakilirsa program cikarimi uc noktalari 503 doner, geri kalan uygulama
# etkilenmez. Bkz. DEPLOY-REHBERI.md SS9.7.
ANTHROPIC_API_KEY=changeme-anthropic-api-anahtari
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_MAX_OUTPUT_TOKENS=128000
